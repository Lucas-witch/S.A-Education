# Configurações de ambiente para S.A Education
APP_ENV=development
APP_BASE_URL=http://localhost/meus%20projetos/S.A%20Education
# Gere um segredo aleatório com pelo menos 32 caracteres; não use este arquivo em produção.
APP_SECRET=
# ID da conta explicitamente designada como administradora; configurar fora do repositório.
APP_ADMIN_USER_ID=
SESSION_COOKIE_SECURE=false

DB_HOST=localhost
DB_NAME=sa_education
DB_USER=root
DB_PASS=
DB_PORT=3306
DB_AUTO_CREATE=true
DB_AUTO_MIGRATE=true

# SMTP para recuperação de senha e convites (Gmail: senha de app com verificação em duas etapas).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_ENCRYPTION=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=S.A Education

# Video lessons
# Apply db/migrate_video_learning.php up before enabling the lesson player.
# No real ad provider is connected in this repository; the player will report test mode and fail open.
VIDEO_PREMIUM_AD_FREE=false

# OAuth credentials (preencher se for habilitar autenticação social)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# App
DEV_MODE=true
