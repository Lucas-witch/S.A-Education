Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^assets/(.*)$ apps/web/public/assets/$1 [L]
</IfModule>

<IfModule mod_authz_core.c>
    <FilesMatch "^\.env(?:\..*)?$">
        Require all denied
    </FilesMatch>
    <FilesMatch "^\.git">
        Require all denied
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    <FilesMatch "^sw\.js$">
        Header set Cache-Control "no-cache, max-age=0, must-revalidate"
    </FilesMatch>
</IfModule>
